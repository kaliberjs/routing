{
  "typeAcquisition": {
    "enable": true
  },
  "include": [
    "./src/**/*",
    "./scripts/**/*",
    "./typescript/**/*",
    "index.js"
  ],
  "exclude": [
  ],
  "compilerOptions": {
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "downlevelIteration": true,
    "lib": [
      "dom",
      "esnext"
    ],
    "jsx": "react",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "*": ["./typescript/node_modules/*"]
    },
    "allowUmdGlobalAccess": true,
    "module": "preserve",
    "allowImportingTsExtensions": true
  }
}
